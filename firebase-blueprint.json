{
  "entities": {
    "User": {
      "title": "User",
      "description": "Public and core profile record for an authenticated platform user.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "username": { "type": "string", "minLength": 3, "maxLength": 32, "pattern": "^[a-z0-9_\\-]+$" },
        "email": { "type": "string", "maxLength": 254, "format": "email" },
        "displayName": { "type": "string", "maxLength": 80 },
        "photoURL": { "type": "string", "maxLength": 500 },
        "role": { "type": "string", "enum": ["USER", "ADMIN"] },
        "status": { "type": "string", "enum": ["ACTIVE", "SUSPENDED"] },
        "storageQuotaBytes": { "type": "number" },
        "storageUsedBytes": { "type": "number" },
        "twoFactorEnabled": { "type": "boolean" },
        "emailVerified": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "username", "email", "displayName", "role", "status", "storageQuotaBytes", "storageUsedBytes", "twoFactorEnabled", "createdAt", "updatedAt"]
    },
    "Website": {
      "title": "Website",
      "description": "Metadata and deployment state for a tenant website project.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerUsername": { "type": "string", "maxLength": 32 },
        "name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "slug": { "type": "string", "minLength": 3, "maxLength": 48, "pattern": "^[a-z0-9\\-]+$" },
        "description": { "type": "string", "maxLength": 500 },
        "visibility": { "type": "string", "enum": ["PUBLIC", "UNLISTED"] },
        "entryFile": { "type": "string", "maxLength": 120 },
        "status": { "type": "string", "enum": ["DRAFT", "QUEUED", "PUBLISHING", "PUBLISHED", "FAILED", "SUSPENDED", "ARCHIVED"] },
        "primaryHostname": { "type": "string", "maxLength": 160 },
        "storageBytes": { "type": "number" },
        "publishedVersionId": { "type": "string", "maxLength": 128 },
        "currentVersionNumber": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "ownerUsername", "name", "slug", "description", "visibility", "entryFile", "status", "primaryHostname", "storageBytes", "publishedVersionId", "currentVersionNumber", "createdAt", "updatedAt"]
    },
    "Domain": {
      "title": "Domain",
      "description": "Subdomain or custom domain record mapped to a website.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "websiteId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "hostname": { "type": "string", "minLength": 4, "maxLength": 160 },
        "domainType": { "type": "string", "enum": ["SUBDOMAIN", "CUSTOM"] },
        "verificationStatus": { "type": "string", "enum": ["VERIFIED", "PENDING", "FAILED"] },
        "verificationToken": { "type": "string", "maxLength": 128 },
        "isPrimary": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "websiteId", "userId", "hostname", "domainType", "verificationStatus", "verificationToken", "isPrimary", "createdAt"]
    },
    "WebsiteVersion": {
      "title": "WebsiteVersion",
      "description": "Immutable deployment snapshot record for a website.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "websiteId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "versionNumber": { "type": "number" },
        "storagePrefix": { "type": "string", "maxLength": 200 },
        "deploymentStatus": { "type": "string", "enum": ["PUBLISHED", "SUPERSEDED", "FAILED"] },
        "fileCount": { "type": "number" },
        "totalBytes": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "websiteId", "userId", "versionNumber", "storagePrefix", "deploymentStatus", "fileCount", "totalBytes", "createdAt"]
    },
    "StorageObject": {
      "title": "StorageObject",
      "description": "Static file object (HTML, CSS, JS, SVG, image) belonging to a website draft or published version.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "websiteId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "versionId": { "type": "string", "maxLength": 128 },
        "objectKey": { "type": "string", "maxLength": 240 },
        "fileName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "mimeType": { "type": "string", "maxLength": 80 },
        "sizeBytes": { "type": "number" },
        "content": { "type": "string", "maxLength": 500000 },
        "isPublic": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "websiteId", "versionId", "objectKey", "fileName", "mimeType", "sizeBytes", "content", "isPublic", "createdAt", "updatedAt"]
    },
    "CoinWallet": {
      "title": "CoinWallet",
      "description": "User virtual coin balance and lifetime summary.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "balance": { "type": "number" },
        "totalEarned": { "type": "number" },
        "totalSpent": { "type": "number" },
        "lastDailyRewardAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "balance", "totalEarned", "totalSpent", "lastDailyRewardAt", "updatedAt"]
    },
    "CoinTransaction": {
      "title": "CoinTransaction",
      "description": "Immutable ledger entry for every coin credit or debit.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "amount": { "type": "number" },
        "balanceAfter": { "type": "number" },
        "transactionType": {
          "type": "string",
          "enum": ["REGISTRATION_BONUS", "DAILY_REWARD", "WEBSITE_PUBLISH", "WEBSITE_RENAME", "DOMAIN_CHANGE", "STORAGE_UPGRADE", "REDEEM_REWARD", "ADMIN_CREDIT", "ADMIN_DEBIT", "REFUND"]
        },
        "referenceId": { "type": "string", "maxLength": 128 },
        "idempotencyKey": { "type": "string", "maxLength": 128 },
        "description": { "type": "string", "maxLength": 240 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "amount", "balanceAfter", "transactionType", "referenceId", "idempotencyKey", "description", "createdAt"]
    },
    "RedeemCode": {
      "title": "RedeemCode",
      "description": "Promotional code configured by an administrator.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "code": { "type": "string", "minLength": 4, "maxLength": 40 },
        "codeHash": { "type": "string", "maxLength": 128 },
        "coinAmount": { "type": "number" },
        "maxRedemptions": { "type": "number" },
        "perUserLimit": { "type": "number" },
        "currentRedemptions": { "type": "number" },
        "expiresAt": { "type": "string", "maxLength": 64 },
        "isActive": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "code", "codeHash", "coinAmount", "maxRedemptions", "perUserLimit", "currentRedemptions", "expiresAt", "isActive", "createdAt"]
    },
    "RedeemRedemption": {
      "title": "RedeemRedemption",
      "description": "Record of a user redeeming a promotional code.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "redeemCodeId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "code": { "type": "string", "maxLength": 40 },
        "userId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "coinAmount": { "type": "number" },
        "coinTransactionId": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "redeemCodeId", "code", "userId", "coinAmount", "coinTransactionId", "createdAt"]
    },
    "Notification": {
      "title": "Notification",
      "description": "In-app notification delivered to a specific user.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "title": { "type": "string", "maxLength": 120 },
        "message": { "type": "string", "maxLength": 400 },
        "category": { "type": "string", "enum": ["PUBLISH", "WALLET", "SECURITY", "DOMAIN", "SYSTEM"] },
        "isRead": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "title", "message", "category", "isRead", "createdAt"]
    },
    "AdminAuditLog": {
      "title": "AdminAuditLog",
      "description": "Immutable audit log entry for administrative actions.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "adminUserId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "adminEmail": { "type": "string", "maxLength": 254 },
        "action": { "type": "string", "maxLength": 80 },
        "targetType": { "type": "string", "maxLength": 40 },
        "targetId": { "type": "string", "maxLength": 128 },
        "reason": { "type": "string", "minLength": 3, "maxLength": 400 },
        "metadataSummary": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "adminUserId", "adminEmail", "action", "targetType", "targetId", "reason", "metadataSummary", "createdAt"]
    },
    "PlatformSettings": {
      "title": "PlatformSettings",
      "description": "Global platform configuration and coin pricing settings.",
      "type": "object",
      "properties": {
        "platformName": { "type": "string", "maxLength": 80 },
        "registrationEnabled": { "type": "boolean" },
        "maintenanceMode": { "type": "boolean" },
        "publishingEnabled": { "type": "boolean" },
        "coinSystemEnabled": { "type": "boolean" },
        "maxWebsitesPerUser": { "type": "number" },
        "uploadSizeLimitMb": { "type": "number" },
        "defaultStorageQuotaBytes": { "type": "number" },
        "registrationBonusCoins": { "type": "number" },
        "publishPriceCoins": { "type": "number" },
        "renamePriceCoins": { "type": "number" },
        "domainChangePriceCoins": { "type": "number" },
        "dailyRewardCoins": { "type": "number" },
        "storageUpgradePriceCoins": { "type": "number" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["platformName", "registrationEnabled", "maintenanceMode", "publishingEnabled", "coinSystemEnabled", "maxWebsitesPerUser", "uploadSizeLimitMb", "defaultStorageQuotaBytes", "registrationBonusCoins", "publishPriceCoins", "renamePriceCoins", "domainChangePriceCoins", "dailyRewardCoins", "storageUpgradePriceCoins", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "User profile and quota records."
    },
    "/websites/{websiteId}": {
      "schema": { "$ref": "#/entities/Website" },
      "description": "Tenant website metadata and deployment states."
    },
    "/domains/{domainId}": {
      "schema": { "$ref": "#/entities/Domain" },
      "description": "Subdomain and custom domain mappings."
    },
    "/website_versions/{versionId}": {
      "schema": { "$ref": "#/entities/WebsiteVersion" },
      "description": "Published snapshot versions of tenant websites."
    },
    "/storage_objects/{objectId}": {
      "schema": { "$ref": "#/entities/StorageObject" },
      "description": "Static files (HTML, CSS, JS, SVG) for drafts and published versions."
    },
    "/coin_wallets/{userId}": {
      "schema": { "$ref": "#/entities/CoinWallet" },
      "description": "Virtual coin balances per user."
    },
    "/coin_transactions/{txId}": {
      "schema": { "$ref": "#/entities/CoinTransaction" },
      "description": "Immutable transaction ledger for coin credits and debits."
    },
    "/redeem_codes/{codeId}": {
      "schema": { "$ref": "#/entities/RedeemCode" },
      "description": "Administrator-created promotional codes."
    },
    "/redeem_redemptions/{redemptionId}": {
      "schema": { "$ref": "#/entities/RedeemRedemption" },
      "description": "Per-user redemption records."
    },
    "/notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/Notification" },
      "description": "User in-app notifications."
    },
    "/admin_audit_logs/{logId}": {
      "schema": { "$ref": "#/entities/AdminAuditLog" },
      "description": "Immutable audit logs of administrator actions."
    },
    "/platform_settings/{settingId}": {
      "schema": { "$ref": "#/entities/PlatformSettings" },
      "description": "Global platform configuration and coin pricing."
    }
  }
}
